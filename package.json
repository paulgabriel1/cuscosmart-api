{
  "name": "cuscosmart-api",
  "version": "1.0.0",
  "description": "API REST de CuscoSmart IA: atractivos, favoritos, itinerarios ordenados por IA, reseñas verificadas y asistente",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "admin": "node scripts/crearAdmin.js",
    "db:armar": "node scripts/armarSql.js",
    "db:reset": "node scripts/armarSql.js --importar",
    "db:migrar": "node scripts/migrar.js",
    "postman": "node scripts/generarPostman.js",
    "test:api": "node scripts/probarColeccion.js",
    "docs:verificar": "node scripts/verificarDocs.js"
  },
  "keywords": [
    "api-rest",
    "express",
    "mysql",
    "procedimientos-almacenados",
    "jwt",
    "turismo",
    "cusco"
  ],
  "author": "Gabriel Paul Alata Condori, Rodrigo Ccahuana Mayo, Mademil Lucero Alata Condori",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "mysql2": "^3.11.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  }
}
