# Copia este archivo como .env y completa los valores
PORT=3000

# Base de datos (XAMPP). Usa 127.0.0.1, no localhost
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cuscosmart_user
DB_PASSWORD=Cusco2026*
DB_NAME=cuscosmart_db

# Tokens JWT. Genera el secreto con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pega_aqui_un_texto_largo_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRES_IN=8h

# Dirección del front (React)
CORS_ORIGIN=http://localhost:5173

# Opcional: login con Google. Crea un "ID de cliente OAuth" (tipo Aplicación web) en
# https://console.cloud.google.com/apis/credentials con el origen http://localhost:5173
# y pega aquí el ID (termina en .apps.googleusercontent.com). Usa el MISMO en el front.
GOOGLE_CLIENT_ID=
